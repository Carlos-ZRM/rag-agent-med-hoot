# ── Stage 1: build dependencies ──
ARG TARGETPLATFORM=linux/amd64
FROM --platform=${TARGETPLATFORM} python:3.14-slim AS builder

ENV POETRY_VERSION=2.1.3 \
    POETRY_HOME=/opt/poetry \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1

RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}"

WORKDIR /app
COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-root

# ── Stage 2: runtime ──
ARG TARGETPLATFORM=linux/amd64
FROM --platform=${TARGETPLATFORM} python:3.14-slim AS runtime

LABEL maintainer="Carlos-ZRM" \
      description="Health Kahoot – True/False Question Manager"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    JDB_Engine=mongodb \
    MONGO_URI="mongodb://localhost:27017/?directConnection=true" \
    MONGO_DB=health_kahoot

WORKDIR /app

COPY --from=builder /app/.venv .venv
COPY app/ app/
COPY seed_pediatrics.py .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]